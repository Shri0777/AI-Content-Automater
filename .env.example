# Copy to .env and change what you need. Every value here is optional for
# local development: the defaults (in config/settings/) work with
# `docker compose up` and demo mode. Production refuses to start without the
# values marked REQUIRED IN PRODUCTION.

# --- Django ---
DJANGO_SECRET_KEY=change-me                      # REQUIRED IN PRODUCTION
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1         # REQUIRED IN PRODUCTION
# Encrypts saved API keys and tokens. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=<your key>                     # REQUIRED IN PRODUCTION (left out: dev uses a built-in key)

# --- Database and Redis (defaults match docker-compose.yml) ---
POSTGRES_DB=ai_content_automator
POSTGRES_USER=automator
POSTGRES_PASSWORD=automator-dev-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
CELERY_BROKER_URL=redis://localhost:6380/0
CACHE_URL=redis://localhost:6380/1

# --- App behaviour ---
DEMO_MODE=true                    # fake AI, news and social providers; no keys needed
REGISTRATION_MODE=invite          # invite, open or closed
ALLOW_PRIVATE_PROVIDER_URLS=false # true only to reach a model on your own machine (Ollama)
REFRESH_COOKIE_SECURE=true        # dev settings turn this off for http://localhost

# --- Public addresses (production: real https:// values) ---
PUBLIC_API_URL=http://localhost:8000             # REQUIRED IN PRODUCTION (https)
FRONTEND_URL=http://localhost:3000               # REQUIRED IN PRODUCTION (https)
CORS_ALLOWED_ORIGINS=http://localhost:3000       # REQUIRED IN PRODUCTION (https)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# --- Social platform apps (optional) ---
# Each user can save their own developer app in the app (Social accounts).
# An app set here is used only for users who have not saved their own.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- News reading (shared by all users) ---
NEWS_USER_AGENT="AIContentAutomator/1.0 (news reader; self-hosted)"
NEWS_RSS_DAILY_CAP=500
NEWS_HACKERNEWS_DAILY_CAP=300
NEWS_PAGES_DAILY_CAP=300
