# Django
SECRET_KEY=<generate-with-django-command>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=ai_content_automater_dev
DB_USER=postgres
DB_PASSWORD=<your-local-password>
DB_HOST=localhost
DB_PORT=5432

# AI Services (V3 Requirements)
# Generic API keys - provider detected at runtime
TEXT_API_KEY=<your-text-generation-api-key>
TEXT_PROVIDER=<optional: openai|anthropic|auto - defaults to auto>

# Optional: Image generation (deferred in initial implementation)
# IMAGE_API_KEY=<your-image-generation-api-key>
# IMAGE_PROVIDER=<optional: openai|stability|auto>

# Publishing Integration (V3 Requirements)
# Buffer Official GraphQL API for social media publishing
BUFFER_ACCESS_TOKEN=<your-buffer-api-token>
BUFFER_API_URL=https://api.buffer.com

# Research Sources (V3 Requirements)
# RSS/Atom and Google News
GNEWS_API_KEY=<your-gnews-api-key-optional>
# Additional RSS feeds can be configured in the dashboard

# Security
# Encryption key for storing sensitive credentials (auto-generated if missing)
# Generate a stable key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production; do not rotate without re-encrypting stored credentials.
CREDENTIAL_ENCRYPTION_KEY=
