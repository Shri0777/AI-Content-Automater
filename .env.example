# Django
SECRET_KEY=<generate-with-django-command>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=ai_content_automater_dev
DB_USER=postgres
DB_PASSWORD=<your-local-password>
DB_HOST=localhost
DB_PORT=5432

# AI Services (Phase 3+ Requirements)
# Text Generation Configuration
TEXT_PROVIDER=openai  # openai|nvidia|anthropic|auto (default: auto)
TEXT_API_KEY=<your-text-generation-api-key>
TEXT_API_BASE_URL=  # Optional: custom endpoint (e.g., https://integrate.api.nvidia.com/v1 for NVIDIA)
TEXT_MODEL=  # Optional: specific model (e.g., gpt-4o-mini, openai/gpt-oss-20b)

# Image Generation Configuration
IMAGE_PROVIDER=nvidia_flux  # nvidia_flux|auto (default: auto)
IMAGE_API_KEY=<your-nvidia-api-key-for-flux>
IMAGE_MODEL=black-forest-labs/flux-3-image-klein  # NVIDIA FLUX model identifier

# Examples for different configurations:
#
# For OpenAI text generation:
#   TEXT_PROVIDER=openai
#   TEXT_API_KEY=sk-...
#   TEXT_API_BASE_URL=https://api.openai.com/v1
#   TEXT_MODEL=gpt-4o-mini
#
# For NVIDIA text generation (OpenAI-compatible):
#   TEXT_PROVIDER=nvidia
#   TEXT_API_KEY=nvapi-...
#   TEXT_API_BASE_URL=https://integrate.api.nvidia.com/v1
#   TEXT_MODEL=openai/gpt-oss-20b
#
# For NVIDIA FLUX image generation:
#   IMAGE_PROVIDER=nvidia_flux
#   IMAGE_API_KEY=nvapi-...
#   IMAGE_MODEL=black-forest-labs/flux-3-image-klein

# Publishing Integration (V3 Requirements)
# Buffer Official GraphQL API for social media publishing
BUFFER_ACCESS_TOKEN=<your-buffer-api-token>
BUFFER_API_URL=https://api.buffer.com

# Research Sources (V3 Requirements)
# RSS/Atom and Google News
GNEWS_API_KEY=<your-gnews-api-key-optional>
# Additional RSS feeds can be configured in the dashboard

# Security
# Encryption key for storing sensitive credentials (auto-generated if missing)
# Generate a stable key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production; do not rotate without re-encrypting stored credentials.
CREDENTIAL_ENCRYPTION_KEY=
